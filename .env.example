# Host port exposed by Docker Compose.
AIM_PORT=8080

# Required. Use a long random value in every environment.
AIM_JWT_SECRET=
AIM_JWT_EXPIRE_HOURS=72

# Default deployment uses SQLite and named Docker volumes.
AIM_DATABASE_DRIVER=sqlite
AIM_DATABASE_DSN=/app/data/aim.db

# Optional image/build settings.
AIM_IMAGE=aim:local
AIM_CONTAINER_NAME=aim
GO_VERSION=1.25.1
ALPINE_VERSION=3.22
TZ=Asia/Shanghai
AIM_DATA_VOLUME=aim_data
AIM_LOGS_VOLUME=aim_logs
AIM_NETWORK=aim_net

# Optional MySQL deployment. Start with:
# docker compose -f docker-compose.yml -f docker-compose.mysql.yml up -d --build
# If you change AIM_MYSQL_PASSWORD or AIM_MYSQL_DATABASE, update AIM_DATABASE_DSN too.
# AIM_DATABASE_DRIVER=mysql
# AIM_DATABASE_DSN=aim:aim_local_password@tcp(mysql:3306)/aim?charset=utf8mb4&parseTime=True&loc=Local
# AIM_MYSQL_IMAGE=mysql:8.4
# AIM_MYSQL_CONTAINER_NAME=aim-mysql
# AIM_MYSQL_DATABASE=aim
# AIM_MYSQL_USER=aim
# AIM_MYSQL_PASSWORD=aim_local_password
# AIM_MYSQL_ROOT_PASSWORD=aim_local_root_password
# AIM_MYSQL_PORT=3306
# AIM_MYSQL_VOLUME=aim_mysql

AIM_LOG_LEVEL=info
AIM_LOG_FILE=/app/logs/aim.log

# AI can be disabled for a pure chat deployment.
AIM_AI_ENABLED=true
AIM_AI_BASE_URL=
AIM_AI_API_KEY=
AIM_AI_API_KEY_ENV=AIM_AI_API_KEY
AIM_AI_API_KEY_ENCRYPT_KEY=
AIM_AI_API_KEY_ENCRYPT_KEY_ENV=AIM_AI_API_KEY_ENCRYPT_KEY
AIM_AI_DEFAULT_MODEL=
AIM_AI_DEFAULT_BOT_USERNAME=ai_assistant
AIM_AI_DEFAULT_BOT_NICKNAME=蓝妹
AIM_AI_SYSTEM_PROMPT=
AIM_AI_TIMEOUT_SECONDS=60
AIM_AI_MAX_CONTEXT_MESSAGES=12
AIM_AI_TEMPERATURE=0.7
AIM_AI_MAX_TOKENS=1024
