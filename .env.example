# HTTP port exposed on the host.
AIM_PORT=8080

# Required. Use a long random string in every environment.
AIM_JWT_SECRET=
AIM_JWT_EXPIRE_HOURS=72

# SQLite is the only runtime database driver currently wired in code.
AIM_DATABASE_DRIVER=sqlite
AIM_DATABASE_DSN=/app/data/aim.db

AIM_LOG_LEVEL=info
AIM_LOG_FILE=/app/logs/aim.log

# AI can be disabled for a pure chat deployment.
AIM_AI_ENABLED=true
AIM_AI_BASE_URL=
AIM_AI_API_KEY=
AIM_AI_API_KEY_ENCRYPT_KEY=
AIM_AI_DEFAULT_MODEL=
AIM_AI_DEFAULT_BOT_USERNAME=ai_assistant
AIM_AI_DEFAULT_BOT_NICKNAME=蓝妹
AIM_AI_TIMEOUT_SECONDS=60
AIM_AI_MAX_CONTEXT_MESSAGES=12
AIM_AI_TEMPERATURE=0.7
AIM_AI_MAX_TOKENS=1024
